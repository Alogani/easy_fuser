                Ok(()) => { {% call spawn_reply() %} reply.ok(); {% endcall %} }
                Err(e) => {
                    warn!("fsync: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn fsyncdir(&self, req: &Request, ino: INodeNo, fh: FileHandle, datasync: bool, reply: ReplyEmpty) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        {% call spawn() %}
            match handler.fsyncdir(
                &req,
                resolver.resolve_id(ino),
                unsafe { BorrowedFileHandle::from_fuser_file_handle(fh) },
                datasync,
            ) {
                Ok(()) => { {% call spawn_reply() %} reply.ok(); {% endcall %} }
                Err(e) => {
                    warn!("fsyncdir: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn getattr(&self, req: &Request, ino: INodeNo, fh: Option<FileHandle>, reply: ReplyAttr) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        {% call spawn() %}
            match handler.getattr(
                &req,
                resolver.resolve_id(ino),
                fh.map(|fh| unsafe { BorrowedFileHandle::from_fuser_file_handle(fh) })
            ) {
                {{ reply_attr() }}
                Err(e) => {
                    warn!("getattr: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn getlk(
        &self,
        req: &Request,
        ino: INodeNo,
        fh: FileHandle,
        lock_owner: LockOwner,
        start: u64,
        end: u64,
        typ: i32,
        pid: u32,
        reply: ReplyLock,
    ) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        {% call spawn() %}
            let lock_info = LockInfo {
                start,
                end,
                lock_type: LockType::from_bits_retain(typ),
                pid,
            };
            match handler.getlk(
                &req,
                resolver.resolve_id(ino),
                unsafe { BorrowedFileHandle::from_fuser_file_handle(fh) },
                lock_owner,
                lock_info,
            ) {
                Ok(lock_info) => { {% call spawn_reply() %}
                    reply.locked(
                        lock_info.start,
                        lock_info.end,
                        lock_info.lock_type.bits(),
                        lock_info.pid,
                    )
                {% endcall %} }
                Err(e) => {
                    warn!("getlk: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn getxattr(&self, req: &Request, ino: INodeNo, name: &OsStr, size: u32, reply: ReplyXattr) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        let name = name.to_owned();
        {% call spawn() %}
            match handler.getxattr(&req, resolver.resolve_id(ino), &name, size) {
                Ok(xattr_data) => { {% call spawn_reply() %}
                    if size == 0 {
                        reply.size(xattr_data.len() as u32);
                    } else if size >= xattr_data.len() as u32 {
                        reply.data(&xattr_data);
                    } else {
                        reply.error(PosixError::new(ErrorKind::ResultTooLarge, "Result too large for specified buffer size").into());
                    }
                {% endcall %} }
                Err(e) => {
                    warn!("getxattr: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn ioctl(
        &self,
        req: &Request,
        ino: INodeNo,
        fh: FileHandle,
        flags: fuser::IoctlFlags,
        cmd: u32,
        in_data: &[u8],
        out_size: u32,
        reply: ReplyIoctl,
    ) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        let in_data = in_data.to_owned();
        {% call spawn() %}
            match handler.ioctl(
                &req,
                resolver.resolve_id(ino),
                unsafe { BorrowedFileHandle::from_fuser_file_handle(fh) },
                FUSEIoctlFlags::from(flags),
                cmd,
                in_data,
                out_size,
            ) {
                Ok((result, data)) => { {% call spawn_reply() %} reply.ioctl(result, &data); {% endcall %} }
                Err(e) => {
                    warn!("ioctl: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn link(
        &self,
        req: &Request,
        ino: INodeNo,
        newparent: INodeNo,
        newname: &OsStr,
        reply: ReplyEntry,
    ) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        let newname = newname.to_owned();
        {% call spawn() %}
            match handler.link(&req,
                resolver.resolve_id(ino),
                resolver.resolve_id(newparent),
                &newname
            ) {
                {% call reply_entry("newparent", "newname") %}{% endcall %}
                Err(e) => {
                    warn!("link: parent_ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            }
        {% endcall %}
    }

    fn listxattr(&self, req: &Request, ino: INodeNo, size: u32, reply: ReplyXattr) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        {% call spawn() %}
            match handler.listxattr(&req, resolver.resolve_id(ino), size) {
                Ok(xattr_data) => { {% call spawn_reply() %}
                    if size == 0 {
                        reply.size(xattr_data.len() as u32);
                    } else if size >= xattr_data.len() as u32 {
                        reply.data(&xattr_data);
                    } else {
                        reply.error(PosixError::new(ErrorKind::ResultTooLarge, "Result too large for specified buffer size").into());
                    }
                {% endcall %} }
                Err(e) => {
                    warn!("listxattr: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn lookup(&self, req: &Request, parent: INodeNo, name: &OsStr, reply: ReplyEntry) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        let name = name.to_owned();
        {% call spawn() %}
            match handler.lookup(&req, resolver.resolve_id(parent), &name) {
                {% call reply_entry("parent", "name") %}{% endcall %}
                Err(e) => {
                    // Failure is expected if user try to lookup a nonexistent file, it should not emit a warning
                    info!("lookup: parent_ino {:x?}, [{}], {:?}", parent, e, req);
                    {{ reply_error() }}
                }
            }
        {% endcall %}
    }

    fn lseek(
        &self,
        req: &Request,
        ino: INodeNo,
        fh: FileHandle,
        offset: i64,
        whence: i32,
        reply: ReplyLseek,
    ) {
        let req = RequestInfo::from(req);
