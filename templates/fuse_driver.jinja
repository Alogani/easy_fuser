type DirIter<TAttr> = HashMap<(INodeNo, u64), VecDeque<(OsString, INodeNo, TAttr)>>;

{% if mode == "serial" %}
    #[cfg(feature = "deadlock_detection")]
    use parking_lot::Mutex;
    #[cfg(not(feature = "deadlock_detection"))]
    use std::sync::Mutex;

{% elif mode == "parallel" %}
    use std::sync::Arc;
    use threadpool::ThreadPool;

    #[cfg(feature = "deadlock_detection")]
    use parking_lot::Mutex;
    #[cfg(not(feature = "deadlock_detection"))]
    use std::sync::Mutex;

{% elif mode == "async" %}
    use std::sync::Arc;
    use tokio::runtime::Runtime;
    use tokio::sync::Mutex;
{% endif %}

pub(crate) struct FuseDriver<TId, THandler>
where
    TId: FileIdType,
    THandler: FuseHandler<TId>,
{
    {% if !send_sync %}
        handler: THandler,
        resolver: TId::Resolver,
        dirmap_iter: Mutex<DirIter<FileKind>>,
        dirmapplus_iter: Mutex<DirIter<FileAttribute>>,
    {% else %}
        handler: Arc<THandler>,
        resolver: Arc<TId::Resolver>,
        dirmap_iter: Arc<Mutex<DirIter<FileKind>>>,
        dirmapplus_iter: Arc<Mutex<DirIter<FileAttribute>>>,
    {% endif %}

    {% if mode == "parallel" %}
        pub threadpool: ThreadPool,
        pub reply_threadpool: ThreadPool,
    {% elif mode == "async" %}
        pub runtime: Arc<Runtime>,
    {% endif %}
}

{% if mode == "parallel" %}
    impl<TId, THandler> Drop for FuseDriver<TId, THandler>
    where
        TId: FileIdType,
        THandler: FuseHandler<TId>,
    {
        fn drop(&mut self) {
            self.threadpool.join();
            self.reply_threadpool.join();
        }
    }
{% endif %}

impl<TId, THandler> FuseDriver<TId, THandler>
where
    TId: FileIdType,
    THandler: FuseHandler<TId>,
{
    pub fn new(
        handler: THandler,
        {% if send_sync %}
            num_threads: usize
        {% else %}
            _num_threads: usize
        {% endif %}
    ) -> FuseDriver<TId, THandler> {
        {% if mode == "parallel" %}
            #[cfg(feature = "deadlock_detection")]
            spawn_deadlock_checker();
        {% endif %}

        FuseDriver {
            {% if mode == "serial" %}
                handler,
                resolver: TId::Resolver::new(),
                dirmap_iter: Mutex::new(HashMap::new()),
                dirmapplus_iter: Mutex::new(HashMap::new()),
            {% else %}
                handler: Arc::new(handler),
                resolver: Arc::new(TId::create_resolver()),
                dirmap_iter: Arc::new(Mutex::new(HashMap::new())),
                dirmapplus_iter: Arc::new(Mutex::new(HashMap::new())),
            {% endif %}

            {% if mode == "parallel" %}
                threadpool: ThreadPool::new(num_threads),
                reply_threadpool: ThreadPool::new(num_threads),
            {% elif mode == "async" %}
                runtime: Arc::new(Runtime::new().unwrap()),
            {% endif %}
        }
    }

    {% if !send_sync %}
        pub fn get_handler(&self) -> &THandler {
            &self.handler
        }

        pub fn get_resolver(&self) -> &TId::Resolver {
            &self.resolver
        }

        pub fn get_dirmap_iter(&self) -> &Mutex<DirIter<FileKind>> {
            &self.dirmap_iter
        }

        pub fn get_dirmapplus_iter(&self) -> &Mutex<DirIter<FileAttribute>> {
            &self.dirmapplus_iter
        }
    {% else %}
        pub fn get_handler(&self) -> Arc<THandler> {
            self.handler.clone()
        }

        pub fn get_resolver(&self) -> Arc<TId::Resolver> {
            self.resolver.clone()
        }

        pub fn get_dirmap_iter(&self) -> Arc<Mutex<DirIter<FileKind>>> {
            self.dirmap_iter.clone()
        }

        pub fn get_dirmapplus_iter(&self) -> Arc<Mutex<DirIter<FileAttribute>>> {
            self.dirmapplus_iter.clone()
        }
    {% endif %}
}



impl<TId, THandler> fuser::Filesystem for FuseDriver<TId, THandler>
where
    TId: FileIdType,
    THandler: FuseHandler<TId>,
{
    {% macro spawn() -%}
        {% if mode == "parallel" %}
            let reply_threadpool = self.reply_threadpool.clone();
            self.threadpool.execute(move || {
        {% elif mode == "async" %}
            let runtime = self.runtime.clone();
            runtime.spawn(async move {
        {% endif %}
        
        {{ caller() }}
        
        {% if mode == "parallel" || mode == "async" %}
            });
        {% endif %}
    {%- endmacro %}

    {% macro spawn_reply() -%}
        {% if mode == "parallel" %}
            reply_threadpool.execute(move || {
        {% elif mode == "async" %}
            runtime.spawn(async move {
        {% endif %}
        
        {{ caller() }}
        
        {% if mode == "parallel" || mode == "async" %}
            });
        {% endif %}
    {%- endmacro %}

    {% macro reply_error() -%}
        {% call spawn_reply() %}
            reply.error(e.into());
        {% endcall %}
    {%- endmacro %}

    {% macro reply_entry(parent, name) -%}
        Ok(metadata) => {
            let default_ttl = handler.get_default_ttl();
            let (id, file_attr) = TId::extract_metadata(metadata);
            let ino = resolver.lookup({{ parent }}, &{{ name }}, id, true);
            let (fuse_attr, ttl, generation) = file_attr.to_fuse(ino);
            {% call spawn_reply() %}
                reply.entry(
                    &ttl.unwrap_or(default_ttl),
                    &fuse_attr,
                    generation.unwrap_or(get_random_generation()),
                );
            {% endcall %}
        }
    {%- endmacro %}

    {% macro reply_attr() -%}
        Ok(file_attr) => {
            let default_ttl = handler.get_default_ttl();
            let (fuse_attr, ttl, _) = file_attr.to_fuse(ino);
            {% call spawn_reply() %}
                reply.attr(&ttl.unwrap_or(default_ttl), &fuse_attr);
            {% endcall %}
        },
    {%- endmacro %}


    fn init(&mut self, req: &Request, config: &mut KernelConfig) -> Result<(), std::io::Error> {
        let req = RequestInfo::from(req);
        match self.get_handler().init(&req, config) {
            Ok(()) => Ok(()),
            Err(e) => {
                warn!("[{}] init {:?}", e, req);
                Err(std::io::Error::from_raw_os_error(e.raw_error()))
            }
        }
    }

    fn destroy(&mut self) {
        self.get_handler().destroy();
    }

    fn access(&self, req: &Request, ino: INodeNo, mask: fuser::AccessFlags, reply: ReplyEmpty) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        {% call spawn() %}
            match handler.access(
                &req,
                resolver.resolve_id(ino),
                AccessMask::from(mask),
            ) {
                Ok(()) => { {% call spawn_reply() %}reply.ok();{% endcall %} }
                Err(e) => {
                    warn!("access: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
                
            };
        {% endcall %}
    }

    fn bmap(&self, req: &Request, ino: INodeNo, blocksize: u32, idx: u64, reply: ReplyBmap) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        {% call spawn() %}
            match handler.bmap(&req, resolver.resolve_id(ino), blocksize, idx) {
                Ok(block) => { {% call spawn_reply() %}reply.bmap(block);{% endcall %} }
                Err(e) => {
                    warn!("bmap: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn copy_file_range(
        &self,
        req: &Request,
        ino_in: INodeNo,
        fh_in: FileHandle,
        offset_in: i64,
        ino_out: INodeNo,
        fh_out: FileHandle,
        offset_out: i64,
        len: u64,
        flags: fuser::CopyFileRangeFlags,
        reply: ReplyWrite,
    ) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        {% call spawn() %}
            match handler.copy_file_range(
                &req,
                resolver.resolve_id(ino_in),
                unsafe { BorrowedFileHandle::from_fuser_file_handle(fh_in) },
                offset_in,
                resolver.resolve_id(ino_out),
                unsafe { BorrowedFileHandle::from_fuser_file_handle(fh_out) },
                offset_out,
                len,
                CopyFileRangeFlags::from(flags),
            ) {
                Ok(bytes_written) => { {% call spawn_reply() %} reply.written(bytes_written);{% endcall %} }
                Err(e) => {
                    warn!("copy_file_range: ino {:x?}, [{}], {:?}", ino_in, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn create(
        &self,
        req: &Request,
        parent: INodeNo,
        name: &OsStr,
        mode: u32,
        umask: u32,
        flags: i32,
        reply: ReplyCreate,
    ) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        let name = name.to_owned();
        {% call spawn() %}
            let helper = CreateHelper::new(&reply);
            match handler.create(
                &req,
                resolver.resolve_id(parent),
                &name,
                mode,
                umask,
                OpenFlags::from_bits_retain(flags),
                helper,
            ) {
                Ok((file_handle, metadata, response_flags, passthrough_backing_id)) => {
                    let default_ttl = handler.get_default_ttl();
                    let (id, file_attr) = TId::extract_metadata(metadata);
                    let ino = resolver.lookup(parent, &name, id, true);
                    let (fuse_attr, ttl, generation) = file_attr.to_fuse(ino);
                    {% call spawn_reply() %}
                        match passthrough_backing_id {
                            #[cfg(feature = "passthrough")]
                            Some(passthrough_backing_id) => {
                                let response_flags =
                                    response_flags | FUSEOpenResponseFlags::PASSTHROUGH;
                                reply.created_passthrough(
                                    &ttl.unwrap_or(default_ttl),
                                    &fuse_attr,
                                    generation.unwrap_or(get_random_generation()),
                                    file_handle.as_fuser_file_handle(),
                                    FopenFlags::from(response_flags),
                                    passthrough_backing_id.as_ref(),
                                );
                            },
                            _ => {
                                let response_flags =
                                    response_flags & !FUSEOpenResponseFlags::PASSTHROUGH;
                                reply.created(
                                    &ttl.unwrap_or(default_ttl),
                                    &fuse_attr,
                                    generation.unwrap_or(get_random_generation()),
                                    file_handle.as_fuser_file_handle(),
                                    FopenFlags::from(response_flags),
                                );
                            }
                        }
                    {% endcall %}
                }
                Err(e) => {
                    warn!("create: {:?}, parent_ino: {:x?}, {:?}", parent, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

    fn fallocate(
        &self,
        req: &Request,
        ino: INodeNo,
        fh: FileHandle,
        offset: u64,
        length: u64,
        mode: i32,
        reply: ReplyEmpty,
    ) {
        let req = RequestInfo::from(req);
        let handler = self.get_handler();
        let resolver = self.get_resolver();
        {% call spawn() %}
            match handler.fallocate(
                &req,
                resolver.resolve_id(ino),
                unsafe { BorrowedFileHandle::from_fuser_file_handle(fh) },
                offset,
                length,
                FallocateFlags::from_bits_retain(mode),
            ) {
                Ok(()) => { {% call spawn_reply() %} reply.ok(); {% endcall %} }
                Err(e) => {
                    warn!("fallocate: ino {:x?}, [{}], {:?}", ino, e, req);
                    {{ reply_error() }}
                }
            };
        {% endcall %}
    }

