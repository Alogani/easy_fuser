use std::ffi::{OsStr, OsString};
use std::path::Path;
use std::time::Duration;

use crate::types::*;
use easy_fuser_macro::fuse_handler_fnsig;

{% if mode == "async" %}
use async_trait::async_trait;
{% endif %}

/// The `FuseHandler` trait is the core interface for implementing a userspace filesystem via FUSE (Filesystem in Userspace).
///
/// This trait defines methods that correspond to various filesystem operations. By implementing this trait,
/// you can create custom filesystem behaviors for your FUSE-based filesystem.
///
/// # Type Parameter
///
/// - `TId`: A type that implements `FileIdType`, identifying a filesystem object.
/// - `FileHandle`: An owned resource for one particular open instance, such as an
///   `OwnedFd`, a cursor, or a backend-specific reader. The driver stores it and
///   resolves FUSE's opaque numeric handle before calling file operations.
///
/// # Usage
///
/// Implement this trait for your filesystem. Presets such as `MirrorFs` provide
/// selected operations that you can delegate to with `delegate_fs!`; they do
/// not implement this trait for you. Use `StatelessHandler` only for its
/// simple directory methods, and `UnimplementedFuseHandler` for unsupported
/// operations that should return `ENOSYS`.
///
/// ## Example: Custom Filesystem with MirrorFs as base
///
/// ```rust,ignore
/// use easy_fuser::fuse_presets::mirror_fs::*;
/// use easy_fuser::fuse_presets::{StatelessHandler, UnimplementedFuseHandler};
/// use easy_fuser::fuse_parallel::prelude::*; // or fuse_serial::prelude::* or fuse_async::prelude::*
/// use easy_fuser_macro::delegate_fs; // or delegate_fs_sync_to_async for async mode
/// use std::path::PathBuf;
/// use std::ffi::OsStr;
///
/// struct MyCustomFs {
///     mirror_fs: MirrorFs,
///     defaults: StatelessHandler<PathBuf>,
///     unimplemented: UnimplementedFuseHandler<PathBuf>,
/// }
///
/// impl FuseHandler for MyCustomFs {
///     type TId = PathBuf;
///     type FileHandle = std::os::fd::OwnedFd;
///
///     // Custom implementation for lookup:
///     fn lookup(&self, req: &RequestInfo, parent_id: PathBuf, name: &OsStr) -> FuseResult<FileAttribute> {
///         // Custom logic for lookup operation...
///         // Delegate to mirror_fs:
///         self.mirror_fs.lookup(req, parent_id, name)
///     }
///
///     // Simple directory operations that need no extra state:
///     delegate_fs! { defaults, [ forget, fsyncdir, opendir, releasedir ] }
///
///     // Unsupported operations return ENOSYS:
///     delegate_fs! { unimplemented, [ statfs, link ] }
///
///     // Delegate file operations to MirrorFs:
///     delegate_fs! { mirror_fs, [ read, write, getattr ] }
/// }
/// ```
///
/// # Per-open file state
///
/// `FileHandle` is the type returned by successful `open` and `create` calls. The driver keeps
/// each value in its private handle table and passes it back to later file callbacks. It allocates
/// a separate opaque FUSE number for each live open, independently of the value of your type, so
/// equal `FileHandle` values still belong to separate opens. Most callbacks receive
/// `Option<&mut Self::FileHandle>` so state such as a cursor can be updated. `None` means there is
/// no resource for that request, which stateless handlers can ignore. `copy_file_range` receives
/// shared optional references for both opens because it may refer to the same open handle.
/// `release` consumes the optional owned value; its default implementation drops the resource.
/// The driver serializes callbacks that use the same open resource. Different opens have separate
/// locks; if their values share mutable backend state, your handler must synchronize that state.
///
/// Choose `()` if your callbacks do not need per-open state. If you delegate descriptor operations
/// to `FileDescriptorHandler`, use `std::os::fd::OwnedFd`: you do not have to implement its FD
/// callbacks, but the helper needs the owned descriptor. If you implement file callbacks yourself,
/// define a type for the state you want to keep; [the typed handle example](crate::types::file_handle)
/// demonstrates a cursor-backed handle.
///
/// # Important Methods
///
/// While all methods in this trait are important for a fully functional filesystem, some key methods include:
///
/// - `lookup`: Look up a directory entry by name and get its attributes.
/// - `getattr`: Get file attributes.
/// - `read`: Read data from a file.
/// - `write`: Write data to a file.
/// - `readdir`: Read directory contents.
/// - `open`: Open a file.
/// - `create`: Create and open a file.
///
/// # Default Implementations
///
/// `FuseHandler` has default bodies for selected callbacks. Presets are separate
/// structs: they provide only the operations documented for them, and you must
/// explicitly delegate those operations or implement them in your handler.
///
/// # Multithreading, Safety, Traits & Lifetime
///
/// ## Using serial feature
///
/// This trait is bound by the `'static` lifetime. However, it doesn't need `Send` or `Sync`.
///
/// **Note:** Using `spawn_mount` for your filesystem will require at least the `Send` trait.
///
/// ## Using parallel or async feature
///
/// This trait requires `Send + Sync` and `'static` lifetime.
///
/// **Important:** FUSE will lock some operations to run at the same time with the same inode, such as `readdir`.
/// This behaviour is not well documented and cannot be guaranteed for now.
///
/// # Additional Resources:
/// For more detailed information, refer to the fuser project documentation, which serves as the foundation for this crate: <https://docs.rs/fuser>
///
/// Documentation is inspired by the original fuser documentation
{%- if mode == "async" %}
#[async_trait]
{%- endif %}
pub trait FuseHandler: 'static
    {% if mode != "serial" %}
        + Send + Sync{# Never put this on serial mode #}
    {% endif %}
{
    type TId: FileIdType {% if mode == "async" %}+ Send{% endif %};
    /// The owned resource kept for one successful `open` or `create` call.
    /// The driver assigns a separate opaque FUSE number to each live open and
    /// maps it to this value, so equal `FileHandle` values from different opens
    /// remain separate. The type does not need to contain a unique ID or be
    /// `Clone` or `Sync`; it must be `'static`, and parallel and async modes
    /// also require `Send`.
    ///
    /// Choose `()` when file operations are stateless. Choose `OwnedFd` when
    /// delegating descriptor operations to `FileDescriptorHandler`; the helper
    /// handles the descriptor callbacks, but still needs the resource type to
    /// be `OwnedFd`. For custom file operations, define a type for the per-open
    /// state and use it in the callback's `Option<&mut Self::FileHandle>`.
    type FileHandle: 'static {% if mode != "serial" %}+ Send{% endif %};

    {% macro async_keyword() -%}{% if mode == "async" %}async{% endif %}{%- endmacro %}
    {% macro await_keyword() -%}{% if mode == "async" %}.await{% endif %}{%- endmacro %}

    /// Provide the fallback metadata timeout used in FUSE replies.
    ///
    /// Defaults to one second. A `FileAttribute` with `ttl: Some(duration)`
    /// uses that duration instead for its reply. This timeout applies to
    /// attribute replies, including `getattr`, `setattr`, `lookup`,
    /// entry-creating callbacks, and `readdirplus`. For replies that return an entry
    /// (`lookup`, `create`, `mkdir`, `mknod`, `symlink`, `link`, and
    /// `readdirplus`), this crate passes the same timeout for both the
    /// attribute and name-to-inode entry cache. For `getattr` and `setattr`,
    /// it is the attribute-cache timeout. fuser 0.18 offers
    /// `ReplyEntry::entry_with_ttls` for separate values, but `easy_fuser` does
    /// not currently expose separate entry and attribute timeouts. This is
    /// separate from file-data caching.
    ///
    /// **Warning:** Do not choose this timeout randomly per callback. It is a
    /// cache-validity interval, so random values make revalidation timing
    /// unpredictable. FUSE accepts a timeout on each reply; using a stable
    /// timeout is guidance for predictable behavior, not a protocol rule.
    /// See libfuse's [`attr_timeout`](https://libfuse.github.io/doxygen/struct_fuse_entry_param.html#attr_timeout)
    /// and [`entry_timeout`](https://libfuse.github.io/doxygen/struct_fuse_entry_param.html#entry_timeout)
    /// descriptions, plus fuser's [`ReplyEntry::entry`](https://docs.rs/fuser/0.18.0/fuser/struct.ReplyEntry.html#method.entry)
    /// and [`ReplyEntry::entry_with_ttls`](https://docs.rs/fuser/0.18.0/fuser/struct.ReplyEntry.html#method.entry_with_ttls).
    fn get_default_ttl(&self) -> Duration {
        Duration::from_secs(1)
    }

    /// Initialize the filesystem and configure kernel connection
    /// 
    /// A default implementation is provided that does nothing
    fn init(&self, req: &RequestInfo, config: &mut KernelConfig) -> FuseResult<()> {
        let _req = req;
        let _config = config;
        Ok(())
    }

    fuse_handler_fnsig!{
        /// Perform cleanup operations on filesystem exit
        /// 
        /// A default implementation is provided that does nothing
        destroy => {}
    }

    /// Check file access permissions
    ///
    /// This method is called for the access() system call. If the 'default_permissions'
    /// mount option is given, this method is not called. This method is not called
    /// under Linux kernel versions 2.4.x
    {{ async_keyword() }} fn access(&self, req: &RequestInfo, file_id: Self::TId, mask: AccessFlags) -> FuseResult<()>;

    /// Map block index within file to block index within device
    ///
    /// Note: This makes sense only for block device backed filesystems mounted
    /// with the 'blkdev' option
    {{ async_keyword() }} fn bmap(&self, req: &RequestInfo, file_id: Self::TId, blocksize: u32, idx: u64) -> FuseResult<u64>;

    /// Copy the specified range from the source inode to the destination inode
    {{ async_keyword() }} fn copy_file_range(
        &self,
        req: &RequestInfo,
        file_in: Self::TId,
        file_handle_in: Option<&Self::FileHandle>,
        offset_in: u64,
        file_out: Self::TId,
        file_handle_out: Option<&Self::FileHandle>,
        offset_out: u64,
        len: u64,
        flags: CopyFileRangeFlags,
    ) -> FuseResult<u32>;

    /// Create and open a regular file.
    ///
    /// On success, return its per-open handle, metadata, and response flags.
    /// The driver stores the handle, registers the new name and lookup
    /// reference, and sends a create reply containing the open handle. The
    /// handle is passed to later file callbacks and consumed by `release`; do
    /// not construct an opaque FUSE handle yourself. Return `()` as the handle
    /// type when file operations need no per-open state.
    ///
    /// `flags` contains the open flags supplied for creation (the upstream
    /// `fuser` API documents `O_NOCTTY` as the exception). On applicable
    /// protocol/kernel versions, FUSE may use `mknod` followed by `open` when
    /// `create` is unavailable. See the [upstream `fuser` create contract](https://docs.rs/fuser/0.18.0/fuser/trait.Filesystem.html#method.create)
    /// for its protocol/kernel details.
    {{ async_keyword() }} fn create(
        &self,
        req: &RequestInfo,
        parent_id: Self::TId,
        name: &OsStr,
        mode: u32,
        umask: u32,
        flags: OpenFlags,
    ) -> FuseResult<(Self::FileHandle, <Self::TId as FileIdType>::Metadata, FopenFlags)>;

    /// Preallocate or deallocate space to a file
    {{ async_keyword() }} fn fallocate(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: Option<&mut Self::FileHandle>,
        offset: i64,
        length: i64,
        mode: FallocateFlags,
    ) -> FuseResult<()>;

    /// Flush cached data for an open file
    ///
    /// Called on each close() of the opened file. Not guaranteed to be called after writes or at all.
    /// Used for returning write errors or removing file locks.
    {{ async_keyword() }} fn flush(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: Option<&mut Self::FileHandle>,
        lock_owner: u64,
    ) -> FuseResult<()>;

    #[allow(unused_variables)]
    /// Release filesystem-owned state for lookup references the kernel drops.
    ///
    /// The kernel uses this notification when it drops inode lookup references;
    /// `nlookup` is the number to release and may be greater than one. There is
    /// no reply, and FUSE does not guarantee a final `forget` for every inode
    /// at unmount.
    ///
    /// The default does nothing. For `Inode`, use this callback to retire your
    /// own lookup-owned state when appropriate, while accounting for open
    /// handles separately. For `PathBuf` and `MappedInode`, the driver updates
    /// its lookup accounting after this callback; do not decrement that
    /// internal count yourself. The callback may still release other
    /// filesystem-owned state. An inode can remain usable after its last name
    /// is unlinked while lookups or open handles still refer to it.
    {{ async_keyword() }} fn forget(&self, req: &RequestInfo, file_id: Self::TId, nlookup: u64) {}

    /// Synchronize file contents
    ///
    /// If datasync is true, only flush user data, not metadata.
    {{ async_keyword() }} fn fsync(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: Option<&mut Self::FileHandle>,
        datasync: bool,
    ) -> FuseResult<()>;

    /// Synchronize directory contents
    ///
    /// If the datasync parameter is true, then only the directory contents should
    /// be flushed, not the metadata. The file_handle will contain the value set
    /// by the opendir method, or will be undefined if the opendir method didn't
    /// set any value.
    {{ async_keyword() }} fn fsyncdir(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: BorrowedFileHandle<'_>,
        datasync: bool,
    ) -> FuseResult<()>;

    /// Return the current attributes for a file or directory.
    ///
    /// The kernel may serve cached attributes until the timeout attached to a
    /// previous metadata reply expires. `FileAttribute::ttl` overrides
    /// `get_default_ttl()` for this reply; `None` uses the default. If a handle
    /// is available, it is passed as `Some`, which can be needed to access an
    /// open object after its last directory name has been removed.
    {{ async_keyword() }} fn getattr(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: Option<&mut Self::FileHandle>,
    ) -> FuseResult<FileAttribute>;

    /// Test for a POSIX file lock.
    {{ async_keyword() }} fn getlk(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: Option<&mut Self::FileHandle>,
        lock_owner: u64,
        lock_info: LockInfo,
    ) -> FuseResult<LockInfo>;

    /// Get an extended attribute
    {{ async_keyword() }} fn getxattr(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        name: &OsStr,
        size: u32,
    ) -> FuseResult<Vec<u8>>;

    /// control device
    {{ async_keyword() }} fn ioctl(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: Option<&mut Self::FileHandle>,
        flags: IoctlFlags,
        cmd: u32,
        in_data: Vec<u8>,
        out_size: u32,
    ) -> FuseResult<(i32, Vec<u8>)>;

    /// Create a hard link and return metadata for the linked object.
    ///
    /// Perform the backing operation before returning success, and return
    /// metadata reflecting the resulting object, including its link count. The
    /// driver registers the added name after success. With `MappedInode`, the
    /// new path is then available through `paths()` and `parts_paths()`; with
    /// `Inode`, return the same inode identity for every hard link. `PathBuf`
    /// keeps path-based identities and does not represent hard links as one
    /// shared identity.
    {{ async_keyword() }} fn link(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        newparent: Self::TId,
        newname: &OsStr,
    ) -> FuseResult<<Self::TId as FileIdType>::Metadata>;

    /// List extended attribute names
    {{ async_keyword() }} fn listxattr(&self, req: &RequestInfo, file_id: Self::TId, size: u32) -> FuseResult<Vec<u8>>;

    /// Retrieve attributes for a directory entry by name.
    ///
    /// On success, return the target's metadata. The driver replies with those
    /// attributes and, for `PathBuf` and `MappedInode`, records the
    /// `(parent, name)` association and kernel lookup reference internally. For
    /// `Inode`, the returned inode number is passed through and your filesystem
    /// supplies and manages that identity. Do not increment an `easy_fuser`
    /// lookup count yourself.
    ///
    /// The kernel can continue to request an inode after its final name has
    /// been unlinked. Keep it addressable while it has outstanding lookup
    /// references or open handles. The matching `forget` callback releases
    /// lookup references, but may not be called for every inode at unmount.
    {{ async_keyword() }} fn lookup(&self, req: &RequestInfo, parent_id: Self::TId, name: &OsStr) -> FuseResult<<Self::TId as FileIdType>::Metadata>;

    /// Reposition read/write file offset
    {{ async_keyword() }} fn lseek(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: Option<&mut Self::FileHandle>,
        seek: SeekFrom,
    ) -> FuseResult<i64>;

    /// Create a directory and return its metadata.
    ///
    /// After success, the driver registers the new directory name and lookup
    /// reference and replies with the metadata. `FileAttribute::ttl` on that
    /// metadata overrides `get_default_ttl()` for the reply. For `Inode`,
    /// provide the inode identity; for `PathBuf` and `MappedInode`, the driver
    /// assigns it. The handler remains responsible for creating the backing
    /// directory.
    {{ async_keyword() }} fn mkdir(
        &self,
        req: &RequestInfo,
        parent_id: Self::TId,
        name: &OsStr,
        mode: u32,
        umask: u32,
    ) -> FuseResult<<Self::TId as FileIdType>::Metadata>;

    /// Create a filesystem node and return its metadata.
    ///
    /// `mode`, `umask`, and `rdev` describe the requested node; `rdev` is
    /// represented by [`DeviceType`]. After success, the driver registers the
    /// name and lookup reference and replies with the returned metadata. The
    /// handler performs the backing operation and supplies the inode identity
    /// when `TId = Inode`.
    {{ async_keyword() }} fn mknod(
        &self,
        req: &RequestInfo,
        parent_id: Self::TId,
        name: &OsStr,
        mode: u32,
        umask: u32,
        rdev: DeviceType,
    ) -> FuseResult<<Self::TId as FileIdType>::Metadata>;

    /// Open a file and return a file handle.
    ///
    /// The returned resource belongs to this particular open instance. `FuseDriver`
    /// stores it and gives FUSE an opaque numeric handle. Return an owned resource
    /// with a `'static` lifetime; the driver passes it back to subsequent file
    /// operations. Stateless implementations may ignore a missing resource.
    {{ async_keyword() }} fn open(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        flags: OpenFlags,
    ) -> FuseResult<(Self::FileHandle, FopenFlags)>;

    /// Open a directory
    ///
    /// Allows storing a file handle for use in subsequent directory operations.
    {{ async_keyword() }} fn opendir(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        flags: OpenFlags,
    ) -> FuseResult<(OwnedFileHandle, FopenFlags)>;

    /// Read data from a file
    ///
    /// Read should send exactly the number of bytes requested except on EOF or error, otherwise the rest of the data will be substituted with zeroes. An exception to this is when the file has been opened in ‘direct_io’ mode, in which case the return value of the read system call will reflect the return value of this operation. fh will contain the value set by the open method, or will be undefined if the open method didn’t set any value.
    ///
    /// flags: these are the file flags, such as O_SYNC. Only supported with ABI >= 7.9 lock_owner: only supported with ABI >= 7.9
    {{ async_keyword() }} fn read(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: Option<&mut Self::FileHandle>,
        seek: SeekFrom,
        size: u32,
        flags: OpenFlags,
        lock_owner: Option<u64>,
    ) -> FuseResult<Vec<u8>>;

    /// Return directory entries as names and minimal metadata.
    ///
    /// Each `OsString` is one name, not a path, and must not contain `/`. For
    /// `Inode`, minimal metadata is `(Inode, FileKind)`; for `PathBuf` and
    /// `MappedInode`, it is `FileKind` and the driver assigns the inode number.
    ///
    /// This method does not receive a FUSE offset. On an offset-zero request,
    /// the driver obtains this listing, assigns opaque continuation offsets to
    /// the entries, and retains entries that did not fit in a reply buffer for
    /// later requests. Do not encode offsets in the returned metadata. When
    /// FUSE starts again at offset zero, the handler is called for a fresh
    /// listing; the driver does not keep a snapshot for the whole directory
    /// open lifetime. The `opendir` handle, if any, is passed here as a
    /// borrowed handle.
    ///
    /// Ordinary `readdir` does not add kernel lookup references for its
    /// entries. Use `readdirplus` when full attributes are needed in the
    /// directory reply and the associated lookup references should be
    /// registered.
    {{ async_keyword() }} fn readdir(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: BorrowedFileHandle<'_>,
    ) -> FuseResult<Vec<(OsString, <Self::TId as FileIdType>::MinimalMetadata)>>;

    /// Return directory entries with full metadata.
    ///
    /// Names are single entry names and must not contain `/`. The default
    /// implementation calls `readdir` and then `lookup` for each returned
    /// name. The driver registers a lookup reference for each entry in the
    /// `readdirplus` reply. Override this method when full metadata can be
    /// obtained more efficiently or when a combined listing/lookup operation
    /// better matches the backing filesystem. Like `readdir`, this callback
    /// does not receive a directory offset; the driver assigns continuation
    /// offsets and buffers entries across a split reply.
    {{ async_keyword() }} fn readdirplus(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: BorrowedFileHandle<'_>,
    ) -> FuseResult<Vec<(OsString, <Self::TId as FileIdType>::Metadata)>> {
        let readdir_result = self.readdir(req, file_id.clone(), file_handle)
            {{ await_keyword() }}?;
        let mut result = Vec::with_capacity(readdir_result.len());
        for (name, _) in readdir_result.into_iter() {
            let metadata = self.lookup(req, file_id.clone(), &name)
                {{ await_keyword() }}?;
            result.push((name, metadata));
        }
        Ok(result)
    }

    /// Read the target of a symbolic link
    {{ async_keyword() }} fn readlink(&self, req: &RequestInfo, file_id: Self::TId) -> FuseResult<Vec<u8>>;

    /// Release an open file
    ///
    /// Called when all file descriptors are closed and all memory mappings are unmapped.
    /// Guaranteed to be called once for every open() call.
    {{ async_keyword() }} fn release(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: Option<Self::FileHandle>,
        flags: OpenFlags,
        lock_owner: Option<u64>,
        flush: bool,
    ) -> FuseResult<()> {
        let _ = (req, file_id, file_handle, flags, lock_owner, flush);
        Ok(())
    }

    /// Release an open directory
    ///
    /// This method is called exactly once for every successful opendir operation.
    /// The file_handle parameter will contain the value set by the opendir method,
    /// or will be undefined if the opendir method didn't set any value.
    {{ async_keyword() }} fn releasedir(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: OwnedFileHandle,
        flags: OpenFlags,
    ) -> FuseResult<()>;

    /// Remove an extended attribute.
    {{ async_keyword() }} fn removexattr(&self, req: &RequestInfo, file_id: Self::TId, name: &OsStr) -> FuseResult<()>;

    /// Rename a directory entry.
    ///
    /// Perform the backing rename, including the requested `RenameFlags`
    /// semantics, before returning success. If a flag is unsupported by the
    /// backing filesystem, return an appropriate error rather than silently
    /// ignoring it. After success, the driver updates its path resolver for
    /// `PathBuf` and `MappedInode`; on Linux it swaps the two cached names for
    /// `RENAME_EXCHANGE`. For manually managed `Inode` values, update your own
    /// namespace index as part of the successful operation. Keep open handles
    /// and object identity valid across a rename.
    {{ async_keyword() }} fn rename(
        &self,
        req: &RequestInfo,
        parent_id: Self::TId,
        name: &OsStr,
        newparent: Self::TId,
        newname: &OsStr,
        flags: RenameFlags,
    ) -> FuseResult<()>;

    /// Remove a directory name from its parent.
    ///
    /// The handler performs the backing operation. After success, the driver
    /// removes the cached path mapping for `PathBuf` and `MappedInode`; with
    /// manually managed `Inode`, update your own namespace index. A removed
    /// name does not by itself release open handles or outstanding kernel
    /// lookup references, so keep the object usable for those references.
    {{ async_keyword() }} fn rmdir(&self, req: &RequestInfo, parent_id: Self::TId, name: &OsStr) -> FuseResult<()>;

    {{ async_keyword() }} fn setattr(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        attrs: SetAttrRequest,
        file_handle: Option<&mut Self::FileHandle>,
    ) -> FuseResult<FileAttribute>;

    /// Acquire, modify or release a POSIX file lock
    ///
    /// For POSIX threads (NPTL) there's a 1-1 relation between pid and owner, but
    /// otherwise this is not always the case. For checking lock ownership, 'fi->owner'
    /// must be used. The l_pid field in 'struct flock' should only be used to fill
    /// in this field in getlk().
    {{ async_keyword() }} fn setlk(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: Option<&mut Self::FileHandle>,
        lock_owner: u64,
        lock_info: LockInfo,
        sleep: bool,
    ) -> FuseResult<()>;

    /// Set an extended attribute
    {{ async_keyword() }} fn setxattr(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        name: &OsStr,
        value: Vec<u8>,
        flags: SetXAttrFlags,
        position: u32,
    ) -> FuseResult<()>;

    /// Get file system statistics
    {{ async_keyword() }} fn statfs(&self, req: &RequestInfo, file_id: Self::TId) -> FuseResult<StatFs>;

    /// Create a symbolic link and return metadata for the link itself.
    ///
    /// `link_name` is the new entry name and `target` is the link target. After
    /// success, the driver registers the new name and lookup reference and
    /// replies with the metadata. The handler performs the backing operation
    /// and supplies the inode identity when `TId = Inode`.
    {{ async_keyword() }} fn symlink(
        &self,
        req: &RequestInfo,
        parent_id: Self::TId,
        link_name: &OsStr,
        target: &Path,
    ) -> FuseResult<<Self::TId as FileIdType>::Metadata>;

    /// Write data to a file
    ///
    /// Write should return exactly the number of bytes requested except on error. An exception to this is when the file has been opened in ‘direct_io’ mode, in which case the return value of the write system call will reflect the return value of this operation. fh will contain the value set by the open method, or will be undefined if the open method didn’t set any value.
    ///
    /// write_flags: will contain FUSE_WRITE_CACHE, if this write is from the page cache. If set, the pid, uid, gid, and fh may not match the value that would have been sent if write cachin is disabled flags: these are the file flags, such as O_SYNC. Only supported with ABI >= 7.9 lock_owner: only supported with ABI >= 7.9
    {{ async_keyword() }} fn write(
        &self,
        req: &RequestInfo,
        file_id: Self::TId,
        file_handle: Option<&mut Self::FileHandle>,
        seek: SeekFrom,
        data: Vec<u8>,
        write_flags: WriteFlags,
        flags: OpenFlags,
        lock_owner: Option<u64>,
    ) -> FuseResult<u32>;

    /// Remove a non-directory name from its parent directory.
    ///
    /// The handler performs the backing operation. After success, the driver
    /// removes the cached path mapping for `PathBuf` and `MappedInode`; with
    /// manually managed `Inode`, update your own namespace index. A removed
    /// name does not by itself release open handles or outstanding kernel
    /// lookup references, so keep the object usable for those references.
    ///
    /// A `PathBuf` may still resolve to the last remembered path while FUSE
    /// refers to the inode after unlink. That path might later name a different
    /// object. Use the open file handle for an already-open file when possible.
    /// For `MappedInode`, `paths()` is empty after its last known name is
    /// removed; the inode and an open handle can still be used while the object
    /// remains alive.
    {{ async_keyword() }} fn unlink(&self, req: &RequestInfo, parent_id: Self::TId, name: &OsStr) -> FuseResult<()>;
}
