use std::io;
use std::path::Path;

use fuser::{mount as fuser_mount, spawn_mount as fuser_spawn_mount, Config, MountOption};
use log::{error, info{% if mode != "serial" %}, warn{% endif %}};

use crate::types::*;
use crate::FuseSession;
use super::FuseHandler;
use super::fuse_driver::FuseDriver;

{% if mode != "serial" %}
/// Returns the reader count and descriptor-cloning setting to hand to fuser.
///
/// fuser 0.18.0 fails the session with "n_threads != 1 is only supported on
/// Linux" on every other platform, after the filesystem is already mounted.
fn fuser_reader_config(threads: &MountThreads) -> (Option<usize>, bool) {
    if cfg!(target_os = "linux") || threads.fuser_threads <= 1 {
        return (Some(threads.fuser_threads), threads.clone_fuser_fd);
    }
    warn!(
        "{} FUSE reader threads requested, but fuser supports several readers on Linux only; using one",
        threads.fuser_threads
    );
    (Some(1), false)
}

{% endif %}
/// Mounts a FUSE filesystem with independent request-reader and operation-worker counts.
///
/// `fuser_threads` controls the threads that read requests from the kernel;
/// serial mode always uses one reader.
/// `handler_threads` controls easy_fuser's callback pool in parallel mode or
/// Tokio's worker pool in async mode. Passing `None` uses a CPU-based starting
/// point: one reader and one worker for one CPU, one reader and two workers for
/// two CPUs, and otherwise one reader per eight CPUs plus half the CPU count in
/// workers. The CPU-based heuristic enables cloned FUSE descriptors when it
/// selects multiple readers.
/// fuser 0.18.0 supports multiple request-reader threads on Linux only. On
/// macOS and the BSDs a larger `fuser_threads` is reduced to one reader, with a
/// warning, instead of failing the mount; `handler_threads` is unaffected.
/// On Linux, [`MountThreads::with_fuser_fd_cloning`] can give each reader an
/// independent `/dev/fuse` descriptor when multiple readers are used.
pub fn mount<TId, FS, P>(
    filesystem: FS,
    mountpoint: P,
    options: &[MountOption],
    threads: Option<MountThreads>,
) -> io::Result<()>
where
    TId: FileIdType,
    FS: FuseHandler<TId = TId>,
    P: AsRef<Path>,
{
    let threads = threads.unwrap_or_default();
    let driver = FuseDriver::new(filesystem, Some(threads.handler_threads));
    let mountpoint = mountpoint.as_ref();
    let mut config = Config::default();
    config.mount_options = options.to_vec();
{% if mode == "serial" %}
    config.n_threads = Some(1);
{% else %}
    (config.n_threads, config.clone_fd) = fuser_reader_config(&threads);
{% endif %}
    info!("Mounting FUSE filesystem at {}", mountpoint.display());
    match fuser_mount(driver, mountpoint, &config) {
        Ok(()) => {
            info!("FUSE filesystem at {} stopped", mountpoint.display());
            Ok(())
        }
        Err(err) => {
            error!(
                "Failed to mount FUSE filesystem at {}: {}",
                mountpoint.display(),
                err
            );
            Err(err)
        }
    }
}

/// Spawns a FUSE filesystem with independent request-reader and operation-worker counts.
///
/// See [`mount`] for the meaning and defaults of each count.
pub fn spawn_mount<TId, FS, P>(
    filesystem: FS,
    mountpoint: P,
    options: &[MountOption],
    threads: Option<MountThreads>,
) -> io::Result<FuseSession<TId>>
where
    TId: FileIdType,
    FS: FuseHandler<TId = TId> + Send,
    P: AsRef<Path>,
{
    let threads = threads.unwrap_or_default();
    let driver = FuseDriver::new(filesystem, Some(threads.handler_threads));
    let resolver = driver.resolver.clone();
    let mountpoint = mountpoint.as_ref();
    let mut config = Config::default();
    config.mount_options = options.to_vec();
{% if mode == "serial" %}
    config.n_threads = Some(1);
{% else %}
    (config.n_threads, config.clone_fd) = fuser_reader_config(&threads);
{% endif %}
    info!("Mounting FUSE filesystem at {} in the background", mountpoint.display());
    let session = match fuser_spawn_mount(driver, mountpoint, &config) {
        Ok(session) => session,
        Err(err) => {
            error!(
                "Failed to mount FUSE filesystem at {}: {}",
                mountpoint.display(),
                err
            );
            return Err(err);
        }
    };
    info!("FUSE filesystem mounted at {}", mountpoint.display());
    Ok(FuseSession::new(session, resolver))
}
