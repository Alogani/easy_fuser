pub(crate) struct FuseDriver<TId, THandler>
where
    TId: FileIdType,
    THandler: FuseHandler<TId>,
{
    pub resolver: Arc<TId::Resolver>,

    {% if !send_sync %}
        handler: THandler,
        dirmap_iter: RefCell<DirIter<FileKind>>,
        dirmapplus_iter: RefCell<DirIter<FileAttribute>>,
    {% else %}
        handler: Arc<THandler>,
        dirmap_iter: Arc<Mutex<DirIter<FileKind>>>,
        dirmapplus_iter: Arc<Mutex<DirIter<FileAttribute>>>,
    {% endif %}

    {% if mode == "parallel" %}
        pub threadpool: ThreadPool,
        pub reply_threadpool: ThreadPool,
    {% elif mode == "async" %}
        pub runtime: Arc<Runtime>,
    {% endif %}
}

{% if mode == "parallel" %}
    impl<TId, THandler> Drop for FuseDriver<TId, THandler>
    where
        TId: FileIdType,
        THandler: FuseHandler<TId>,
    {
        fn drop(&mut self) {
            self.threadpool.join();
            self.reply_threadpool.join();
        }
    }
{% endif %}

impl<TId, THandler> FuseDriver<TId, THandler>
where
    TId: FileIdType,
    THandler: FuseHandler<TId>,
{
    pub {{ async_keyword() }} fn new(
        handler: THandler,
        {% if send_sync %}
            num_threads: usize
        {% else %}
            _num_threads: usize
        {% endif %}
    ) -> io::Result<FuseDriver<TId, THandler>> {
        {% if mode == "parallel" %}
            #[cfg(feature = "deadlock_detection")]
            spawn_deadlock_checker();
        {% endif %}

        let resolver = Arc::new(TId::create_resolver());
        {% if mode == "async" %}
            let runtime = Arc::new(Runtime::new().unwrap());
            runtime.block_on(async {
                Self::bootstrap_handler(&handler, resolver.clone()).await.map_err(|e| {
                    io::Error::from_raw_os_error(e.raw_error())
                })
            })?;
        {% else %}
            Self::bootstrap_handler(&handler, resolver.clone()).map_err(|e| {
                io::Error::from_raw_os_error(e.raw_error())
            })?;
        {% endif %}

        Ok(FuseDriver {
            resolver: resolver,
            {% if mode == "serial" %}
                handler: handler,
                dirmap_iter: RefCell::new(HashMap::new()),
                dirmapplus_iter: RefCell::new(HashMap::new()),
            {% else %}
                handler: Arc::new(handler),
                dirmap_iter: Arc::new(Mutex::new(HashMap::new())),
                dirmapplus_iter: Arc::new(Mutex::new(HashMap::new())),
            {% endif %}

            {% if mode == "parallel" %}
                threadpool: ThreadPool::new(num_threads),
                reply_threadpool: ThreadPool::new(num_threads),
            {% elif mode == "async" %}
                runtime: runtime,
            {% endif %}
        })
    }

    {% if !send_sync %}
        pub fn get_handler(&self) -> &THandler {
            &self.handler
        }

        pub fn get_dirmap_iter(&self) -> &RefCell<DirIter<FileKind>> {
            &self.dirmap_iter
        }

        pub fn get_dirmapplus_iter(&self) -> &RefCell<DirIter<FileAttribute>> {
            &self.dirmapplus_iter
        }
    {% else %}
        pub fn get_handler(&self) -> Arc<THandler> {
            self.handler.clone()
        }

        pub fn get_dirmap_iter(&self) -> Arc<Mutex<DirIter<FileKind>>> {
            self.dirmap_iter.clone()
        }

        pub fn get_dirmapplus_iter(&self) -> Arc<Mutex<DirIter<FileAttribute>>> {
            self.dirmapplus_iter.clone()
        }
    {% endif %}

    {{ async_keyword() }} pub fn bootstrap_handler(
        handler: &THandler,
        resolver: Arc<TId::Resolver>,
    ) -> FuseResult<()> {
        handler.setup(resolver.clone()){{ await_keyword() }}?;
        let lookup_root_result = handler.lookup_root(){{ await_keyword() }};
        match lookup_root_result {
            Ok(metadata) => {
                let (id, _file_attr) = TId::extract_metadata(metadata);
                resolver.lookup_root(id);
            },
            Err(e) => {
                if e.kind() == ErrorKind::FunctionNotImplemented {
                    // This is normal if the filesystem is not using HybridId, we'll just put a warning here but 
                    // return the error to the caller
                    warn!("[{}] lookup_root", e);
                } else {
                    return Err(e);
                }
            }
        }
        Ok(())
    }
}

