{% if mode == "serial" %}
use std::cell::{RefCell, RefMut};
use std::rc::Rc;
#[cfg(test)]
use std::sync::Arc;
type ResourceGuard<'a, T> = RefMut<'a, Option<T>>;
{% elif mode == "parallel" %}
use super::{LockMutex, Mutex};
use std::sync::Arc;
#[cfg(feature = "deadlock_detection")]
type ResourceGuard<'a, T> = parking_lot::MutexGuard<'a, Option<T>>;
#[cfg(not(feature = "deadlock_detection"))]
type ResourceGuard<'a, T> = std::sync::MutexGuard<'a, Option<T>>;
{% else %}
use std::sync::{Arc, Mutex as TableMutex};
